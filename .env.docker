# Copy this to .env before running docker compose
# Generate JIRA_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate SESSION_SECRET with:      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

POSTGRES_PASSWORD=ltcm_secret
JIRA_ENCRYPTION_KEY=replace_with_64_char_hex
SESSION_SECRET=replace_with_64_char_hex
HOST_PORT=3050
